@model PropertyRepairs.ViewModels.VehicleCheckDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h4>Delivery HGV</h4>
<hr />

@if (!Model.DeliveryHGV.is_complete)
{
    <strong>Not Complete : </strong>@Html.DisplayFor(model => model.DeliveryHGV.ReasonNotCompleted)
}
else
{
<partial name="_VehicleDetailsPartial" model="Model.DeliveryHGV" />

    <u>Marks out of 10</u>
    <br />
    <partial name="_StarRating" model="new Tuple<int, int>(Model.DeliveryHGV.marks_out_of_10, 10)" />

<partial name="_VehicleimagesPartial" model="Model" />
    
}