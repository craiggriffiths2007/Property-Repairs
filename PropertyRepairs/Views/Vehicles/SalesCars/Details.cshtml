@model PropertyRepairs.ViewModels.VehicleCheckDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h4>Sales Car</h4>
<hr />

@if (!Model.SalesCar.is_complete)
{
    <strong>Not Complete : </strong>
    @Html.DisplayFor(model => model.SalesCar.ReasonNotCompleted)
}
else
{
<partial name="_VehicleDetailsPartial" model="Model.SalesCar" />

    <u>Marks out of 10</u>
    <br />
    <partial name="_StarRating" model="new Tuple<int, int>(Model.SalesCar.marks_out_of_10, 10)" />

<partial name="_VehicleimagesPartial" model="Model" />
}