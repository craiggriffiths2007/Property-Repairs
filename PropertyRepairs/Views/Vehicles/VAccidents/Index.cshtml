@model IEnumerable<PropertyRepairs.Models.VAccident>

@{
    ViewData["Title"] = "Index";
}

<h4>Vehicle Accidents</h4>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.acc_date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.acc_time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.t_reg)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.t_model)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">
            <td>
                @Html.DisplayFor(model => item.acc_date)
            </td>
            <td>
                @Html.DisplayFor(model => item.acc_time)
            </td>
            <td>
                    @Html.DisplayFor(model => item.t_reg)
            </td>
            <td>
                @Html.DisplayFor(model => item.t_model)
            </td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
