@model PropertyRepairs.ViewModels.ContractDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h4>Contract</h4>
<hr />

<div>
    
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Contract.ContractCode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contract.ContractCode)
        </dd>
        <dt class = "col-sm-2">
            Customer
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contract.Customer.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Contract.IncidentDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contract.IncidentDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Contract.InsuranceCompanyName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contract.InsuranceCompanyName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Contract.DamageDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Contract.DamageDescription)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Contract.CauseOfDamage)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Contract.CauseOfDamage)
        </dd>
    </dl>
</div>


<div>
    <a asp-action="Edit" asp-route-id="@Model?.Contract.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
<hr />
<h4>Notes</h4>


<table class="table">
    <thead>
        <tr>
            <th class ="col-sm-2">
                Date & Time Added
            </th>
            <th class="col-sm-2">
                Added By
            </th>
            <th>
                Note
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ContractNotes) {
            <tr>
            <td>
                @Html.DisplayFor(modelItem => item.DateAdded)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AddedBy)
            </td>
          
            <td>
                    @Html.DisplayFor(modelItem => item.Note)
            </td>
        </tr>
        }
    </tbody>
</table>

<div class="row">
    <div class="col-md-4">
        <form asp-action="AddNote">
            <input type="hidden" asp-for="Contract.Id" />
            <input type="hidden" asp-for="Contract.ContractCode" />
            <div class="form-group">
                <label asp-for="Note" class="control-label"></label>
                <input asp-for="Note" class="form-control" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Add Note" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>



