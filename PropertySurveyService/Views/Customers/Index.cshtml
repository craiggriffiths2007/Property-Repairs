@model IEnumerable<PropertySurveyService.Models.Customer>

@{
    ViewData["Title"] = "Index";
}

<h4>Customers</h4>

<p>
    <a asp-action="Create">Add Customer</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Add1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Add2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Add3)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Postcode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Phone1)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Add1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Add2)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Add3)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Postcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Phone1)
            </td>

            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<nav aria-label="Customer pages">
    <ul class="pagination">
        @{ var pageNumber = (ViewBag.PageNumber as int?) ?? 1; var totalPages = (ViewBag.TotalPages as int?) ?? 1; }
        <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber - 1)">Previous</a>
        </li>
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber + 1)">Next</a>
        </li>
    </ul>
</nav>
