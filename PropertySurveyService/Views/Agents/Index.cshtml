@model IEnumerable<PropertyRepairs.Models.Agent>

@{
    ViewData["Title"] = "Index";
}

<h4>Agents</h4>

<p>
    <a asp-action="Create">Add Agent</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LoggedInDateTime)
            </th>

            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">
            <td>
                @(((PropertyRepairs.Models.agent_type)item.Type).ToString())
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Code)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Password)
            </td>

                <td>
                    @if (item.LoggedInDateTime.Year != 0001)
                    {
                    @Html.DisplayFor(modelItem => item.LoggedInDateTime)
                    }
                </td>

            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<nav aria-label="Agent pages">
    <ul class="pagination">
        @{ var pageNumber = (ViewBag.PageNumber as int?) ?? 1; var totalPages = (ViewBag.TotalPages as int?) ?? 1; }
        <li class="page-item @(pageNumber <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber - 1)">Previous</a>
        </li>
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == pageNumber ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
        <li class="page-item @(pageNumber >= totalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-page="@(pageNumber + 1)">Next</a>
        </li>
    </ul>
</nav>
