@model PropertySurveyService.Models.SpotCheck
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Details";
}

<div>
    <h4>Spot Check</h4>
    <hr />



    <div class="grid-container-vertical">
        @if (Model == null)
        {
            <div>No data</div>
        }
        else
        {
            var properties = Model.GetType()
                .GetProperties()
                .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
                .Select(p =>
                {
                    var display = p.GetCustomAttribute<DisplayAttribute>();
                    var label = display?.GetName() ?? p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name;
                    // DisplayAttribute exposes GetOrder(); if not set we treat it as max so those appear after ordered ones
                    var order = display?.GetOrder() ?? int.MaxValue;
                    return new
                    {
                        Property = p,
                        Label = label,
                        Order = order
                    };
                })
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Label);

            foreach (var item in properties)
            {
                var value = item.Property.GetValue(Model);

                <div>
                    @item.Label:
                    <strong>
                        @if (value is bool b)
                        {
                            var color = b ? "green" : "red";
                            <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                        }
                        else
                        {
                            @value
                        }
                    </strong>
                </div>
            }


        }
    </div>
    </br>
    <div class="row">
        <div class="col-md-3">
            <u>Appearence</u>
        </div>
        <div class="col-md-4">
            @if (Model.uspot_appearence >= 1 && Model.uspot_appearence <= 5)
            {
                @for (int i = 0; i < Model.uspot_appearence; i++)
                {
                    <img src="~/img/yellow-star.png" alt="Star" style="width: 20px; height: 20px; margin-right: 2px;" />
                }
                @for (int i = 0; i < 5-Model.uspot_appearence; i++)
                {
                    <img src="~/img/yellow-star-empty.png" alt="Star" style="width: 20px; height: 20px; margin-right: 2px;" />
                }
            }
            else
            {
                <span>No rating available</span>
            }
        </div>
    </div>
    <div class="col-md-3">
        @Model.uspot_appearence_improvements
    </div>

    <div class="row">
        <div class="col-md-3">
            <u>Quality of works</u>
        </div>
        <div class="col-md-4">
            @if (Model.uspot_qualityofworks >= 1 && Model.uspot_qualityofworks <= 5)
            {
                @for (int i = 0; i < Model.uspot_qualityofworks; i++)
                {
                    <img src="~/img/yellow-star.png" alt="Star" style="width: 20px; height: 20px; margin-right: 2px;" />
                }
                @for (int i = 0; i < 5 - Model.uspot_qualityofworks; i++)
                {
                    <img src="~/img/yellow-star-empty.png" alt="Star" style="width: 20px; height: 20px; margin-right: 2px;" />
                }
            }
            else
            {
                <span>No rating available</span>
            }
        </div>
    </div>


    <div class="col-md-3">
        @Model.uspot_qualityofworks_improvements
    </div>

    <div class="row">
    <div class="col-md-3">
        <u>Customer satisfaction</u>
        </div>
            <div class="col-md-4">
                @if (Model.uspot_customersatisfaction >= 1 && Model.uspot_customersatisfaction <= 5)
                {
                    @for (int i = 0; i < Model.uspot_customersatisfaction; i++)
                    {
                        <img src="~/img/yellow-star.png" alt="Star" style="width: 20px; height: 20px; margin-right: 2px;" />
                    }
                    @for (int i = 0; i < 5 - Model.uspot_customersatisfaction; i++)
                    {
                        <img src="~/img/yellow-star-empty.png" alt="Star" style="width: 20px; height: 20px; margin-right: 2px;" />
                    }
                }
                else
                {
                    <span>No rating available</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-3">
        @Model.uspot_customersatisfaction_improvements
    </div>
 

    <hr />
    @foreach (var image in ViewBag.Images)
    {
        var fname = image?.Filename as string;
        if(!string.IsNullOrEmpty(fname))
        {
            <img src="@Url.Content($"~/images/{fname}")" class="img-fluid rounded" />
        }
    }


