@model PropertySurveyService.ViewModels.VehicleCheckDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h4>Delivery HGV</h4>
<hr />

@if (!Model.DeliveryHGV.is_complete)
{
    <strong>Not Complete : </strong>@Html.DisplayFor(model => model.DeliveryHGV.ReasonNotCompleted)
}
else
{
<partial name="_VehicleDetailsPartial" model="Model.DeliveryHGV" />
<partial name="_VehicleimagesPartial" model="Model" />
    
}