@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@model PropertyRepairs.ViewModels.VehicleCheckDetailsViewModel


<hr />
<h4>Signatures</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->

        <div class="col-6 p-3 border">Driver Signature<img src="/images/@Model.drv_signature.Filename" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">Checker/Auditor Signature<img src="/images/@Model.chk_signature.Filename" class="img-fluid rounded" /></div>
    </div>
</div>
<h4>Outside Photos</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->
        <div class="col-6 p-3 border">Passenger<img src="/images/@Model.photoLeft.Filename" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">Driver<img src="/images/@Model.photoRight.Filename" class="img-fluid rounded" /></div>
    </div>
    <div class="row">
        <!-- Row 2 -->
        <div class="col-6 p-3 border">Front<img src="/images/@Model.photoFront.Filename" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">Rear<img src="/images/@Model.photoBack.Filename" class="img-fluid rounded" /></div>
    </div>
</div>
<h4>Damage</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->
        <div class="col-6 p-3 border">Passenger<img src="/images/@Model.diagramLeft.Filename" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">Driver<img src="/images/@Model.diagramRight.Filename" class="img-fluid rounded" /></div>
    </div>
    <div class="row">
        <!-- Row 2 -->
        <div class="col-6 p-3 border">Front<img src="/images/@Model.diagramFront.Filename" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">Rear<img src="/images/@Model.diagramBack.Filename" class="img-fluid rounded" /></div>
    </div>
</div>
<h4>Inside Photos</h4>
<div class="container">
    <div class="row">
            @foreach (var image_data in @Model.insidePhotos)
        {
            <div class="col-6 p-3 border"><img src="/images/@image_data.Filename" class="img-fluid rounded" /></div>
        }

    </div>
</div>

