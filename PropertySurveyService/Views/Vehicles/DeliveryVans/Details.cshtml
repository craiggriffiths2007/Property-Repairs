@model PropertySurveyService.ViewModels.VehicleCheckDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h4>Delivery Van</h4>
<hr />

@if (!Model.DeliveryVan.is_complete)
{
    <strong>Not Complete : </strong>
    @Html.DisplayFor(model => model.DeliveryVan.ReasonNotCompleted)
}
else
{
    <partial name="_VehicleDetailsPartial" model="Model.DeliveryVan" />
    <partial name="_VehicleimagesPartial" model="Model" />

}