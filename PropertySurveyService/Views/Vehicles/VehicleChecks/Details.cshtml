@model PropertySurveyService.ViewModels.VehicleCheckHeaderIndexViewModel

@{
    ViewData["Title"] = "Details";
}



<div>
    <h4>Vehicle Check</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VehicleCheckHeader.CheckWeekDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VehicleCheckHeader.CheckWeekDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.VehicleCheckHeader.BranchCode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.VehicleCheckHeader.BranchCode)
        </dd>


    </dl>
</div>

    <h4>Vehicles</h4>
    @if (Model.VehicleCheckVehicles != null && Model.VehicleCheckVehicles.Any())
    {
        <table class="table table-sm table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>Type</th>
                    <th>Registration</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.VehicleCheckVehicles)
                {
                    <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">
                        <td>@item.VehicleName</td>
                        <td>@item.Registration</td>
                        <td align="right">
                            <a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-outline-primary btn-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No vehicles found for this vehicle check.</p>
    }


