@model IEnumerable<PropertySurveyService.Models.VehicleCheckHeader>

@{
    ViewData["Title"] = "Index";
}

<h4>Vehicle Checks</h4>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CheckWeekDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BranchCode)
            </th>
            <th>
                HGVs
            </th>
            <th>
                Delivery Vans
            </th>
            <th>
                Fitter Vans
            </th>
            <th>
                Sales Cars
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">
            <td>
                @Html.DisplayFor(modelItem => item.CheckWeekDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BranchCode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalDeliveryHGVs)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalDeliveryVans)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalFitterVans)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalSalesCars)
            </td>
            <td>

                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
