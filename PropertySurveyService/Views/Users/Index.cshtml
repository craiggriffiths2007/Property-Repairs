@model IEnumerable<PropertySurveyService.Models.UserRolesViewModel>

@{
    ViewData["Title"] = "Users";
}

<h1>Users</h1>

<p>
    <a asp-action="Create" class="btn btn-primary btn-sm">Create New User</a>
</p>
<table class="table table-sm table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Photo</th>
            <th>Username</th>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Roles</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>
                    @if (user.ProfilePicture != null && user.ProfilePicture.Length > 0)
                    {
                        <img src="data:image/png;base64,@Convert.ToBase64String(user.ProfilePicture)" class="img-thumbnail" style="max-width:40px;max-height:40px;" />
                    }
                </td>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@(user.Roles != null ? string.Join(", ", user.Roles) : "")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-outline-primary btn-sm">Edit</a>
                    <a asp-action="Details" asp-route-id="@user.UserId" class="btn btn-outline-secondary btn-sm">Details</a>
                    <a asp-action="Delete" asp-route-id="@user.UserId" class="btn btn-outline-danger btn-sm">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
