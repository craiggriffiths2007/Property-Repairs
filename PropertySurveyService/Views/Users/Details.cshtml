@model PropertySurveyService.Models.UserRolesViewModel

@{
    ViewData["Title"] = "User Details";
}

<h1>Details</h1>

<div>
    <h4>User</h4>
    <hr />
    @if (Model.ProfilePicture != null && Model.ProfilePicture.Length > 0)
    {
        <div class="mb-3">
            <img src="data:image/png;base64,@Convert.ToBase64String(Model.ProfilePicture)" class="img-thumbnail" style="max-width:200px;" />
        </div>
    }
    <dl class="row">
        <dt class="col-sm-2">Username</dt>
        <dd class="col-sm-10">@Model.UserName</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
        <dt class="col-sm-2">First Name</dt>
        <dd class="col-sm-10">@Model.FirstName</dd>
        <dt class="col-sm-2">Last Name</dt>
        <dd class="col-sm-10">@Model.LastName</dd>
        <dt class="col-sm-2">Roles</dt>
        <dd class="col-sm-10">@(Model.Roles != null ? string.Join(", ", Model.Roles) : "None")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.UserId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
