@model PropertyRepairs.Models.LadderCheck
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Details";
}

    <h4>Ladder Check</h4>
    <hr />
    <div class="grid-container-vertical">
        @if (Model == null)
        {
            <div>No data</div>
        }
        else
        {
        var properties = Model.GetType()
            .GetProperties()
            .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
            .Select(p =>
            {
                var display = p.GetCustomAttribute<DisplayAttribute>();
                var label = display?.GetName() ?? p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name;
                // DisplayAttribute exposes GetOrder(); if not set we treat it as max so those appear after ordered ones
                var order = display?.GetOrder() ?? int.MaxValue;
                return new
                {
                    Property = p,
                    Label = label,
                    Order = order
                };
            })
            .OrderBy(x => x.Order)
            .ThenBy(x => x.Label);

            foreach (var item in properties)
            {
                var value = item.Property.GetValue(Model);

                <div>
                    @item.Label:
                    <strong>
                        @if (value is bool b)
                        {
                            var color = b ? "green" : "red";
                            <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                        }
                        else
                        {
                            @value
                        }
                    </strong>
                </div>
            }
        }
    </div>
<hr />
<h4>Signatures</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.fitter_surveyor_name)
            @{ var s1 = ViewData["Sign1"] as string; }
            @if(!string.IsNullOrEmpty(s1))
            {
                <img src="@Url.Content($"~/images/{s1}")" class="img-fluid rounded" />
            }
        </div>
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.managers_name)
            @{ var s2 = ViewData["Sign2"] as string; }
            @if(!string.IsNullOrEmpty(s2))
            {
                <img src="@Url.Content($"~/images/{s2}")" class="img-fluid rounded" />
            }
        </div>
    </div>
    @foreach (var image in ViewBag.Images)
    {
        var fname = image?.Filename as string;
        if(!string.IsNullOrEmpty(fname))
        {
            <img src="@Url.Content($"~/images/{fname}")" class="img-fluid rounded" />
        }
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
