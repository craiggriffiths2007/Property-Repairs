@model PropertySurveyService.Models.LadderCheck
@using System.ComponentModel
@using System.Reflection

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>


    <h4>LadderCheck</h4>
    <hr />
    <div class="grid-container-vertical">
        @if (Model == null)
        {
            <div>No data</div>
        }
        else
        {
            var properties = Model.GetType()
                .GetProperties()
                .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
                .Select(p => new
                {
                    Property = p,
                    Label = p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name
                })
                .OrderBy(x => x.Label);

            foreach (var item in properties)
            {
                var value = item.Property.GetValue(Model);

                <div>
                    @item.Label:
                    <strong>
                        @if (value is bool b)
                        {
                            var color = b ? "green" : "red";
                            <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                        }
                        else
                        {
                            @value
                        }
                    </strong>
                </div>
            }
        }
    </div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
