@model PropertySurveyService.Models.LadderCheck
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Details";
}

    <h4>Ladder Check</h4>
    <hr />
    <div class="grid-container-vertical">
        @if (Model == null)
        {
            <div>No data</div>
        }
        else
        {
        var properties = Model.GetType()
            .GetProperties()
            .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
            .Select(p =>
            {
                var display = p.GetCustomAttribute<DisplayAttribute>();
                var label = display?.GetName() ?? p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name;
                // DisplayAttribute exposes GetOrder(); if not set we treat it as max so those appear after ordered ones
                var order = display?.GetOrder() ?? int.MaxValue;
                return new
                {
                    Property = p,
                    Label = label,
                    Order = order
                };
            })
            .OrderBy(x => x.Order)
            .ThenBy(x => x.Label);

            foreach (var item in properties)
            {
                var value = item.Property.GetValue(Model);

                <div>
                    @item.Label:
                    <strong>
                        @if (value is bool b)
                        {
                            var color = b ? "green" : "red";
                            <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                        }
                        else
                        {
                            @value
                        }
                    </strong>
                </div>
            }
        }
    </div>

<h4>Signatures</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.fitter_surveyor_name)<img src="data:image/png;base64,@ViewData["Sign1"]" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.managers_name)<img src="data:image/png;base64,@ViewData["Sign2"]" class="img-fluid rounded" /></div>
    </div>
    @foreach (var image in ViewBag.Images)
    {
        <img src="data:image/png;base64,@image.Data" class="img-fluid rounded" />
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
