@model IEnumerable<PropertySurveyService.Models.LadderCheck>

@{
    ViewData["Title"] = "Index";
}

<h4>Ladder Checks</h4>

<table class="table">
    <thead>
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.date_done)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.branch)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ladder_number)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ladder_type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.registration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fitter_surveyor_name)
            </th>
            <th>
              
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">

            <td>
                @Html.DisplayFor(model => item.date_done)
            </td>
            <td>
                @Html.DisplayFor(model => item.branch)
            </td>
            <td>
                @Html.DisplayFor(model => item.ladder_number)
            </td>
            <td>
                @Html.DisplayFor(model => item.ladder_type)
            </td>
            <td>
                @Html.DisplayFor(model => item.registration)
            </td>
            <td>
                @Html.DisplayFor(model => item.fitter_surveyor_name)
            </td>
           
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
