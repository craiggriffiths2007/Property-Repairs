@model PropertySurveyService.ViewModels.JobDetailsViewModel


<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label asp-for="Job.DiaryDate" class="control-label"></label>
            <input asp-for="Job.DiaryDate" class="form-control" />
            <span asp-validation-for="Job.DiaryDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Job.Time" class="control-label"></label>
            <input asp-for="Job.Time" class="form-control" />
            <span asp-validation-for="Job.Time" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Job.ContractId" class="control-label">Contract</label>
            <select asp-for="Job.ContractId" class="form-control" asp-items="ViewBag.ContractId" id="ContractId">
                <option value="">-- Select Contract --</option>
            </select>
            <span asp-validation-for="Job.ContractId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Job.InsuranceCompanyName" class="control-label"></label>
            <input asp-for="Job.InsuranceCompanyName" class="form-control" />
            <span asp-validation-for="Job.InsuranceCompanyName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Job.DamageDesc" class="control-label"></label>
            <input asp-for="Job.DamageDesc" class="form-control" />
            <span asp-validation-for="Job.DamageDesc" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Job.CauseOfDamage" class="control-label"></label>
            <input asp-for="Job.CauseOfDamage" class="form-control" />
            <span asp-validation-for="Job.CauseOfDamage" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Job.JobType" class="control-label">Job Type</label>
            <select asp-for="Job.JobType" class="form-control" asp-items="@((SelectList)ViewBag.JobTypes)" id="JobType"></select>
            <span asp-validation-for="Job.JobType" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Job.AgentId" class="control-label">Agent</label>
            <select asp-for="Job.AgentId" class="form-control" asp-items="ViewBag.AgentId" id="AgentId"></select>
        </div>

        <div class="form-group d-flex justify-content-between align-items-center pt-2">
            <label asp-for="Job.bRequestRepudiation" class="form-check-label mb-0">
                Repudiate if Wnt or Bad Workmanship
            </label>
            <input asp-for="Job.bRequestRepudiation" class="form-check-input position-static me-0" />
            <span asp-validation-for="Job.bRequestRepudiation" class="text-danger"></span>
        </div>

        <div id="recentSurvey" style="display: none;">
            <br />
            <div class="text-decoration-underline">Recent Survey</div>
            <dl class="row">
                <dt class="col-sm-4">Agent</dt>
                <dd class="col-sm-8" id="surveyAgentCode"></dd>

                <dt class="col-sm-4">Diary Date</dt>
                <dd class="col-sm-8" id="surveyDiaryDate"></dd>

                <dt class="col-sm-4">Completed</dt>
                <dd class="col-sm-8" id="surveyCompleted"></dd>
            </dl>

            <div class="form-group d-flex justify-content-between align-items-center">
                <label asp-for="Job.bIncludeSurvey" class="form-check-label mb-0">
                    Include Recent Survey
                </label>
                <input asp-for="Job.bIncludeSurvey" class="form-check-input position-static me-0" id="includeRecentSurveyCheck" />
                <span asp-validation-for="Job.bIncludeSurvey" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="form-group">
            <label asp-for="Job.Instructions" class="control-label"></label>

            <input type="hidden" asp-for="Job.Instructions" id="instructions-hidden" />

            <div id="instructions-editor" style="height: 600px;">
                @Html.Raw(Model.Job?.Instructions)
            </div>

            <span asp-validation-for="Job.Instructions" class="text-danger"></span>
        </div>

       
    </div>
</div>

<link href="~/lib/quill.snow.css" rel="stylesheet" />

<script src="~/lib/quill.js"></script>

<script>
    // Initialize Quill editor with color pickers
    const quill = new Quill('#instructions-editor', {
    theme: 'snow',
    modules: {
    toolbar: [
    
    // Added 'color' and 'background' here:
    [{ 'color': [] }, { 'background': [] }],
    ['bold', 'italic', 'underline', 'strike', 'list'],
    [ 'image', 'blockquote', 'code-block'],
    [{ 'list': 'ordered'}, { 'list': 'bullet' }]
    ]
    }
    });

    // Find the closest form containing the editor
    const form = document.querySelector('#instructions-editor').closest('form');
    const hiddenInput = document.getElementById('instructions-hidden');

    // Intercept the form submit to pass Quill's HTML into the ASP.NET hidden input
    form.addEventListener('submit', function() {
    // Get HTML content from Quill
    const htmlContent = quill.getSemanticHTML();

    // Put it in the hidden input so ASP.NET can bind it to Job.Instructions
    hiddenInput.value = htmlContent;
    });
</script>
<script>
        document.getElementById('ContractId').addEventListener('change', function () {
        var contractId = this.value;
        if (contractId) {
            fetch('@Url.Action("GetContractInformation", "Jobs")' + '?id=' + contractId)
                .then(response => response.json())
                .then(data => {
                    // Fixed: Added "Job_" prefix to match MVC auto-generated IDs
                    document.getElementById('Job_DamageDesc').value = data.damageDescription || '';
                    document.getElementById('Job_InsuranceCompanyName').value = data.insuranceCompany || '';
                    document.getElementById('Job_CauseOfDamage').value = data.causeOfDamage || '';

                    GetRecentSurvey();
                });
        } else {
            // Fixed here as well
            document.getElementById('Job_DamageDesc').value = '';
            document.getElementById('Job_InsuranceCompanyName').value = "";
            document.getElementById('Job_CauseOfDamage').value = "";
            hideSurvey();
        }
    });

    function GetRecentSurvey() {
        var contractId = document.getElementById('ContractId').value;
        if (contractId) {
            fetch('@Url.Action("GetRecentSurvey", "Jobs")' + '?id=' + contractId)
                .then(response => response.json())
                .then(data => {
                    if (data.agentCode == null) {
                        hideSurvey();
                    } else {
                        document.getElementById('surveyAgentCode').textContent = data.agentCode;
                        document.getElementById('surveyDiaryDate').textContent = data.diaryDate;
                        document.getElementById('surveyCompleted').textContent = data.completed;
                        showSurvey();
                    }
                });
        } else {
            hideSurvey();
        }
    }

    function hideSurvey() {
        document.getElementById('recentSurvey').style.display = 'none';
        document.getElementById('includeRecentSurveyCheck').checked = false;
    }

    function showSurvey() {
        document.getElementById('recentSurvey').style.display = 'block';
    }

    function UpdateAgentsList() {
        var jobType = document.getElementById('JobType');
        debugger ;
        if (jobType && jobType.value) {
            fetch('@Url.Action("GetAgentListForJobType", "Jobs")' + '?jobType=' + jobType.value)
                .then(response => response.json())
                .then(data => {
                    const agentSelect = document.getElementById('AgentId');
                    agentSelect.innerHTML = '';
                    data.forEach(agent => {
                        const option = document.createElement('option');
                        option.value = agent.value;
                        option.text = agent.text;
                        agentSelect.appendChild(option);
                    });
                });

                if(jobType.value == 1)
                {
                    document.getElementById('includeRecentSurveyCheck').checked = true;
                }
        }
    }

    document.getElementById('JobType').addEventListener('change', UpdateAgentsList);

    document.addEventListener('DOMContentLoaded', function () {
        GetRecentSurvey();
        UpdateAgentsList();
    });
</script>