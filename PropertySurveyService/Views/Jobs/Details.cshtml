@model PropertySurveyService.Models.Job

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Job</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContractCode)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContractCode)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Date)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Date)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.JobType)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.JobType)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Time)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Time)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DamageDesc)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DamageDesc)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Instructions)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Instructions)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Agent)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Agent.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Customer)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Customer.Add1)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

@if (ViewBag.Headers is IEnumerable<PropertySurveyService.Models.JobHeader> headers && headers.Any())
{
    <hr />
    <h4>PDA Records</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Type</th>
                <th>Agent</th>
                <th>Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var header in headers)
            {
                <tr>
                    <td>@header.JobType</td>
                    <td>@header.AgentCode</td>
                    <td>@header.DiaryDate</td>
                    <td>
                        @if (header.bComplete)
                        {
                            <span class="badge bg-success">Complete</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">In Progress</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="JobHeaders" asp-action="Details" asp-route-id="@header.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <p class="text-muted">No survey records found for this job.</p>
}
