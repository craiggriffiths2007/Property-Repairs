@model PropertySurveyService.ViewModels.JobDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h4>Diary Booking - @Html.DisplayFor(model => model.Job.JobType)</h4>
<hr />
<div>

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.ContractCode)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.ContractCode)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.DiaryDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.DiaryDate)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.JobType)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.JobType)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.Time)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Time)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.InsuranceCompanyName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.InsuranceCompanyName)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.DamageDesc)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.DamageDesc)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.CauseOfDamage)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.CauseOfDamage)
                </dd>

                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.Agent)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Agent.Code) - @Html.DisplayFor(model => model.Job.Agent.Name)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.Customer.Name)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Customer.Name)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.Customer.Add1)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Customer.Add1)
                </dd>
                <dt class="col-sm-3">
                    &nbsp;
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Customer.Add2)
                </dd>
                <dt class="col-sm-3">
                    &nbsp;
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Customer.Add3)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.Customer.Postcode)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Job.Customer.Postcode)
                </dd>
                            </dl>
        </div>

        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Job.Instructions)
                </dt>
                <div id="instructions-editor" >
                    @Html.Raw(Model.Job?.Instructions)
                </div>
               

            </dl>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Job?.Id" >Edit</a> |
    <a asp-action="Index">Back to Diary</a>
</div>
<link href="~/lib/quill.snow.css" rel="stylesheet" />
<script src="~/lib/quill.js"></script>
<script>
    // Initialize Quill editor with color pickers
    const quill = new Quill('#instructions-editor', {
        theme: 'snow',
        readOnly: true,
        modules: {
            toolbar: '#toolbar-container'
        }
    });

    // Find the closest form containing the editor
    const form = document.querySelector('#instructions-editor').closest('form');
    const hiddenInput = document.getElementById('instructions-hidden');

    // Intercept the form submit to pass Quill's HTML into the ASP.NET hidden input
    form.addEventListener('submit', function() {
        // Get HTML content from Quill
        const htmlContent = quill.getSemanticHTML();

        // Put it in the hidden input so ASP.NET can bind it to Job.Instructions
        hiddenInput.value = htmlContent;
    });
</script>

@if(Model.JobHeaderIndex?.Any() == true)
{
    <hr />
    <h4>Completed Jobs</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Type</th>
                <th>Agent</th>
                <th>Diary Date</th>
                <th>DateTime Completed</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var header in Model.JobHeaderIndex)
            {
                <tr>
                    <td>@header.JobType</td>
                    <td>@header.AgentCode</td>
                    <td>@header.DiaryDate.ToShortDateString()</td>
                    <td>@header.DateTimeCompleted</td>
                    <td align="right">
                        <a asp-controller="JobHeaders" asp-action="Details" asp-route-id="@header.Id" asp-route-jobid="@Model.Job.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <p class="text-muted">No survey records found for this job.</p>
}
