@model PropertySurveyService.Models.Job

@{
    ViewData["Title"] = "Details";
}

<h4>Diary Job Details</h4>
<hr />
<div>

    <div class="row">
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.ContractCode)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.ContractCode)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.DiaryDate)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.DiaryDate)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.JobType)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.JobType)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Time)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Time)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.InsuranceCompanyName)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.InsuranceCompanyName)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.DamageDesc)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.DamageDesc)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.CauseOfDamage)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CauseOfDamage)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Instructions)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Instructions)
                </dd>
            </dl>
        </div>
        <div class="col-md-6">
            <dl class="row">


                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Agent)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Agent.Code) - @Html.DisplayFor(model => model.Agent.Name)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Customer.Name)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Customer.Name)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Customer.Add1)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Customer.Add1)
                </dd>
                <dt class="col-sm-3">
                    &nbsp;
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Customer.Add2)
                </dd>
                <dt class="col-sm-3">
                    &nbsp;
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Customer.Add3)
                </dd>
                <dt class="col-sm-3">
                    @Html.DisplayNameFor(model => model.Customer.Postcode)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Customer.Postcode)
                </dd>
            </dl>
        </div>
    </div>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

@if (ViewBag.Headers is IEnumerable<PropertySurveyService.Models.JobHeader> headers && headers.Any())
{
    <hr />
    <h4>Completed Contract Jobs</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Type</th>
                <th>Agent</th>
                <th>Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var header in headers)
            {
                <tr>
                    <td>@header.JobType</td>
                    <td>@header.AgentCode</td>
                    <td>@header.DiaryDate.ToShortDateString()</td>
                    
                    <td>
                        <a asp-controller="JobHeaders" asp-action="Details" asp-route-id="@header.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <p class="text-muted">No survey records found for this job.</p>
}
