@model PropertySurveyService.ViewModels.JobIndexViewModel;

@{
    ViewData["Title"] = "Diary";

    var currentDate = new DateTime(Model.Year, Model.Month, 1);
    var prevMonth = currentDate.AddMonths(-1);
    var nextMonth = currentDate.AddMonths(1);
    var daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
    int startDayOfWeek = (int)currentDate.DayOfWeek;
    // Convert Sunday=0 to Monday-first: Mon=0 .. Sun=6
    startDayOfWeek = (startDayOfWeek == 0) ? 6 : startDayOfWeek - 1;

    var jobsByDay = Model.Jobs?
        .GroupBy(j => j.DiaryDate.Day)
        .ToDictionary(g => g.Key, g => g.ToList())
        ?? new Dictionary<int, List<PropertySurveyService.Models.Job>>();

    // Week view helpers
    var weekStart = Model.WeekStartDate;
    var weekEnd = weekStart.AddDays(6);
    var prevWeek = weekStart.AddDays(-7);
    var nextWeek = weekStart.AddDays(7);
    string[] weekDayNames = { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };

    // Build a lookup: dayOfWeek (0=Mon) -> hour -> list of jobs
    var weekJobs = new Dictionary<int, Dictionary<int, List<PropertySurveyService.Models.Job>>>();
    for (int d = 0; d < 7; d++)
        weekJobs[d] = new Dictionary<int, List<PropertySurveyService.Models.Job>>();

    if (Model.Jobs != null)
    {
        foreach (var job in Model.Jobs)
        {
            int dayIdx = ((int)job.DiaryDate.DayOfWeek - 1 + 7) % 7;
            int hour = job.Time.Hour;
            if (!weekJobs[dayIdx].ContainsKey(hour))
                weekJobs[dayIdx][hour] = new List<PropertySurveyService.Models.Job>();
            weekJobs[dayIdx][hour].Add(job);
        }
    }
}

<h4>Diary</h4>

<!-- Top controls: view toggle (left), prev/next + title (center), search (right) -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center">
        <div class="btn-group me-3" role="group">
            <a asp-action="Index" asp-route-view="month" asp-route-month="@Model.Month" asp-route-year="@Model.Year"
               class="btn btn-sm @(Model.ViewMode == "month" ? "btn-primary" : "btn-outline-primary")">Month</a>
            <a asp-action="Index" asp-route-view="week" asp-route-weekStart="@weekStart.ToString("yyyy-MM-dd")"
               class="btn btn-sm @(Model.ViewMode == "week" ? "btn-primary" : "btn-outline-primary")">Week</a>
            <a asp-action="Index" asp-route-view="list" asp-route-month="@Model.Month" asp-route-year="@Model.Year"
               class="btn btn-sm @(Model.ViewMode == "list" ? "btn-primary" : "btn-outline-primary")">List</a>
        </div>

        <div class="text-center d-none d-md-flex align-items-center">
        @if (Model.ViewMode == "month")
            {
                <a asp-action="Index" asp-route-month="@prevMonth.Month" asp-route-year="@prevMonth.Year" asp-route-view="month" class="btn btn-outline-secondary btn-sm me-2" style="min-width:64px;">&laquo;</a>
                <a asp-action="Index" asp-route-month="@nextMonth.Month" asp-route-year="@nextMonth.Year" asp-route-view="month" class="btn btn-outline-secondary btn-sm me-2" style="min-width:64px;">&raquo;</a>
                <div class="fw-bold fs-5">@currentDate.ToString("MMMM yyyy")</div>
            }
            else if (Model.ViewMode == "week")
            {
                <a asp-action="Index" asp-route-view="week" asp-route-weekStart="@prevWeek.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm me-2" style="min-width:64px;">&laquo;</a>
                <a asp-action="Index" asp-route-view="week" asp-route-weekStart="@nextWeek.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary btn-sm me-2" style="min-width:64px;">&raquo;</a>
                <div class="fw-bold fs-5">@weekStart.ToString("dd MMM") &ndash; @weekEnd.ToString("dd MMM yyyy")</div>
            }
            else
            {
                <a asp-action="Index" asp-route-month="@prevMonth.Month" asp-route-year="@prevMonth.Year" asp-route-view="list" class="btn btn-outline-secondary btn-sm me-2" style="min-width:64px;">&laquo;</a>
                <a asp-action="Index" asp-route-month="@nextMonth.Month" asp-route-year="@nextMonth.Year" asp-route-view="list" class="btn btn-outline-secondary btn-sm me-2" style="min-width:64px;">&raquo;</a>
                <div class="fw-bold fs-5">@currentDate.ToString("MMMM yyyy")</div>
            }
        </div>
    </div>

    <form method="get" asp-action="Index" class="d-flex align-items-center">
        <input type="text" name="q" value="@Model.SearchQuery" class="form-control form-control-sm me-2" placeholder="Search contract, customer or agent" style="min-width:220px;" />
        <input type="hidden" name="view" value="@Model.ViewMode" />
        <input type="hidden" name="month" value="@Model.Month" />
        <input type="hidden" name="year" value="@Model.Year" />
        <input type="hidden" name="weekStart" value="@Model.WeekStartDate.ToString("yyyy-MM-dd")" />
        <button class="btn btn-outline-primary btn-sm" type="submit">Search</button>
        <a class="btn btn-outline-secondary btn-sm ms-2" href="@Url.Action("Index", new { view = Model.ViewMode, month = Model.Month, year = Model.Year })">Clear</a>
    </form>
</div>

@if (Model.ViewMode == "month")
{
    <!-- MONTH VIEW -->


    <p>
        <a asp-action="Create" class="btn btn-primary btn-sm">Add Diary Job</a>
    </p>

    <table class="table table-bordered calendar-table">
        <thead class="table-light">
            <tr>
                <th>Mon</th>
                <th>Tue</th>
                <th>Wed</th>
                <th>Thu</th>
                <th>Fri</th>
                <th>Sat</th>
                <th>Sun</th>
            </tr>
        </thead>
        <tbody>
            @{
                int day = 1;
                int totalCells = startDayOfWeek + daysInMonth;
                int rows = (int)Math.Ceiling(totalCells / 7.0);
            }
            @for (int row = 0; row < rows; row++)
            {
                <tr>
                    @for (int col = 0; col < 7; col++)
                    {
                        int cellIndex = row * 7 + col;
                        if (cellIndex < startDayOfWeek || day > daysInMonth)
                        {
                            <td class="calendar-cell calendar-empty"></td>
                        }
                        else
                        {
                            bool isToday = (day == DateTime.Today.Day && Model.Month == DateTime.Today.Month && Model.Year == DateTime.Today.Year);
                            <td class="calendar-cell @(isToday ? "calendar-today" : "")">
                                <div class="calendar-day-number">@day</div>
                                @if (jobsByDay.ContainsKey(day))
                                {
                                    @foreach (var job in jobsByDay[day])
                                    {
                                        var hasRelevantHeader = false;
                                        if (!string.IsNullOrEmpty(job.ContractCode) && Model.Headers != null)
                                        {
                                            hasRelevantHeader = Model.Headers.Any(h => h.ContractCode == job.ContractCode && h.JobType == job.JobType);
                                        }
                                        <div class="calendar-event @(job.JobType == enum_job_type.Survey ? "job-type-survey" : job.JobType == enum_job_type.Fitting ? "job-type-fitting" : "job-type-remedial") @(hasRelevantHeader ? "has-header" : "")">
                                            <a asp-action="Details" asp-route-id="@job.Id" class="calendar-event-link">
                                                @job.ContractCode - @job.Time.ToString("HH:mm") - @job.Agent.Code
                                                <br/>
                                                @if (job.Customer != null)
                                                {
                                                    <span>@job.Customer.Name - @job.Customer.Postcode</span>
                                                }
                                            </a>
                                        </div>
                                    }
                                }
                            </td>
                            day++;
                        }
                    }
                </tr>
            }
        </tbody>
    </table>
}
else if (Model.ViewMode == "week")
{
    <!-- WEEK VIEW -->


    <p>
        <a asp-action="Create" class="btn btn-primary btn-sm">Add Diary Job</a>
    </p>

    <div class="week-view-container">
        <table class="table table-bordered week-table">
            <thead class="table-light">
                <tr>
                    <th class="week-time-col">Time</th>
                    @for (int d = 0; d < 7; d++)
                    {
                        var colDate = weekStart.AddDays(d);
                        bool isToday = colDate == DateTime.Today;
                        <th class="week-day-col @(isToday ? "week-today-header" : "")">
                            @weekDayNames[d]<br />
                            <span class="week-date-label">@colDate.ToString("dd/MM")</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int hour = 7; hour <= 19; hour++)
                {
                    <tr>
                        <td class="week-time-label">@hour.ToString("00"):00</td>
                        @for (int d = 0; d < 7; d++)
                        {
                            var colDate = weekStart.AddDays(d);
                            bool isToday = colDate == DateTime.Today;
                            <td class="week-cell @(isToday ? "week-today-cell" : "")">
                                @if (weekJobs[d].ContainsKey(hour))
                                {
                                    @foreach (var job in weekJobs[d][hour])
                                    {
                                        var hasRelevantHeader = false;
                                        if (!string.IsNullOrEmpty(job.ContractCode) && Model.Headers != null)
                                        {
                                            hasRelevantHeader = Model.Headers.Any(h => h.ContractCode == job.ContractCode && h.JobType == job.JobType);
                                        }
                                        <div class="calendar-event @(job.JobType == enum_job_type.Survey ? "job-type-survey" : job.JobType == enum_job_type.Fitting ? "job-type-fitting" : "job-type-remedial") @(hasRelevantHeader ? "has-header" : "")">
                                            <a asp-action="Details" asp-route-id="@job.Id" class="calendar-event-link">
                                                @job.ContractCode - @job.Time.ToString("HH:mm") - @job.Agent.Code
                                                <br />
                                                @if (job.Customer != null)
                                                {
                                                    <span>@job.Customer.Name - @job.Customer.Postcode</span>
                                                }
                                            </a>
                                        </div>
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (Model.ViewMode == "list")
{
    <!-- LIST VIEW -->


    <p>
        <a asp-action="Create" class="btn btn-primary btn-sm">Create New Job</a>
    </p>

    <table class="table table-sm table-striped table-bordered">
        <thead class="table-light">
            <tr>
                <th>Contract Code</th>
                <th>Date</th>
                <th>Time</th>
                <th>Customer</th>
                <th>Agent</th>
                <th>Damage</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Jobs != null && Model.Jobs.Any())
            {
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td>@job.ContractCode</td>
                        <td>@job.DiaryDate.ToString("dd/MM/yyyy")</td>
                        <td>@job.Time.ToString("HH:mm")</td>
                        <td>@job.Customer?.Name</td>
                        <td>@job.Agent?.Code</td>
                        <td>@job.DamageDesc</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-secondary btn-sm">Details</a>
                            <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No jobs found for this month.</td>
                </tr>
            }
        </tbody>
    </table>
}

