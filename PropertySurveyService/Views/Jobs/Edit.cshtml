@model PropertySurveyService.Models.Job

@{
    ViewData["Title"] = "Edit";
}

<h4>Diary Job Booking</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="DiaryDate" class="control-label"></label>
                <input asp-for="DiaryDate" class="form-control" />
                <span asp-validation-for="DiaryDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Time" class="control-label"></label>
                <input asp-for="Time" class="form-control" />
                <span asp-validation-for="Time" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ContractId" class="control-label">Contract</label>
                <select asp-for="ContractId" class="form-control" asp-items="ViewBag.ContractId" id="ContractId">
                    <option value="">-- Select Contract --</option>
                </select>
                <span asp-validation-for="ContractId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceCompanyName" class="control-label"></label>
                <input asp-for="InsuranceCompanyName" class="form-control" />
                <span asp-validation-for="InsuranceCompanyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DamageDesc" class="control-label"></label>
                <input asp-for="DamageDesc" class="form-control" />
                <span asp-validation-for="DamageDesc" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CauseOfDamage" class="control-label"></label>
                <input asp-for="CauseOfDamage" class="form-control" />
                <span asp-validation-for="CauseOfDamage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Instructions" class="control-label"></label>
                <input asp-for="Instructions" class="form-control" />
                <span asp-validation-for="Instructions" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="JobType" class="control-label">Job Type</label>
                <select asp-for="JobType" class="form-control" asp-items="@((SelectList)ViewBag.JobTypes)"></select>
                <span asp-validation-for="JobType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AgentId" class="control-label">Agent</label>
                <select asp-for="AgentId" class="form-control" asp-items="ViewBag.AgentId"></select>
            </div>

            <div class="form-group form-check">
                <input asp-for="bIncludeSurvey" class="form-check-input" />
                <label asp-for="bIncludeSurvey" class="form-check-label">Include Recent Survey</label>
                <span asp-validation-for="bIncludeSurvey" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <input asp-for="bRequestRepudiation" class="form-check-input" />
                <label asp-for="bRequestRepudiation" class="form-check-label">Request Repudiation</label>
                <span asp-validation-for="bRequestRepudiation" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.getElementById('ContractId').addEventListener('change', function () {
            var contractId = this.value;
            if (contractId) {
                fetch('@Url.Action("GetContractInformation", "Jobs")' + '?id=' + contractId)
                    .then(response => response.json())
                    .then(data => {
                        document.getElementById('DamageDesc').value = data.damageDescription;
                        document.getElementById('InsuranceCompanyName').value = data.insuranceCompany;
                        document.getElementById('CauseOfDamage').value = data.causeOfDamage;
                    });
            } else {
                document.getElementById('DamageDesc').value = '';
                document.getElementById('InsuranceCompanyName').value = "";
                document.getElementById('CauseOfDamage').value = "";
            }
        });
    </script>
}
