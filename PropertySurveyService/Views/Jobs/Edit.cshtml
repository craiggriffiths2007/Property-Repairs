@model PropertySurveyService.ViewModels.JobDetailsViewModel

@{
    ViewData["Title"] = "Create";
}

<h4>Edit Diary Booking</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Job.Id" />

            <partial name="_JobFormFields" model="Model" />

            <div class="row">
                <div class="col-12 mt-3">
                    <div class="form-group">
                        <input type="submit" value="Save Changes" class="btn btn-primary" />
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Details" asp-route-id="@Model.Job?.Id">Cancel Edit</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}