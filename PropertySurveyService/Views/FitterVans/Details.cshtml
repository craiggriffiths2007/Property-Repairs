@model PropertySurveyService.ViewModels.VehicleCheckDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h1>Fitter Van</h1>


<div class="grid-container-vertical">
    @{
        var properties = Model.FitterVan.GetType()
            .GetProperties().Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
            .Select(p => new
            {
                Property = p,
                Label = p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name
            })
            .OrderBy(x => x.Label);
    }

    @foreach (var item in properties)
    {
        var value = item.Property.GetValue(Model.FitterVan);

        <div>
            @item.Label:
            <strong>
                @if (value is bool b)
                {
                    <span style="color: @(b ? "green" : "red"); font-weight: bold;">
                        @(b ? "✔" : "✘")
                    </span>
                }
                else
                {
                    @value
                }
            </strong>
        </div>
    }
</div>

@if (Model.FitterVan.is_complete)
{
    <h4>Outside Photos</h4>
    <div class="container">
        <div class="row">
            <!-- Row 1 -->
            <div class="col-6 p-3 border">Passenger<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "pas").FirstOrDefault().Data" class="img-fluid rounded" /></div>
            <div class="col-6 p-3 border">Driver<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "drv").FirstOrDefault().Data" class="img-fluid rounded" /></div>
        </div>
        <div class="row">
            <!-- Row 2 -->
            <div class="col-6 p-3 border">Front<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "fro").FirstOrDefault().Data" class="img-fluid rounded" /></div>
            <div class="col-6 p-3 border">Rear<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "rea").FirstOrDefault().Data" class="img-fluid rounded" /></div>
        </div>
    </div>
    <h4>Damage</h4>
    <div class="container">
        <div class="row">
            <!-- Row 1 -->
            <div class="col-6 p-3 border">Passenger<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "pad").FirstOrDefault().Data" class="img-fluid rounded" /></div>
            <div class="col-6 p-3 border">Driver<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "drd").FirstOrDefault().Data" class="img-fluid rounded" /></div>
        </div>
        <div class="row">
            <!-- Row 2 -->
            <div class="col-6 p-3 border">Front<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "frd").FirstOrDefault().Data" class="img-fluid rounded" /></div>
            <div class="col-6 p-3 border">Rear<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "red").FirstOrDefault().Data" class="img-fluid rounded" /></div>
        </div>
    </div>
    <h4>inside Photo</h4>
    <div class="container">
        <div class="row">
            <!-- Row 1 -->
            <div class="col-6 p-3 border"><img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "i01").FirstOrDefault().Data" class="img-fluid rounded" /></div>
        </div>
    </div>
    <h4>Signatures</h4>
    <div class="container">
        <div class="row">
            <!-- Row 1 -->

            <div class="col-6 p-3 border">Driver Signature<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "dsi").FirstOrDefault().Data" class="img-fluid rounded" /></div>
            <div class="col-6 p-3 border">Checker/Auditor Signature<img src="data:image/png;base64,@Model.Images.Where(i => i.Filename.Substring(40, 3) == "csi").FirstOrDefault().Data" class="img-fluid rounded" /></div>
        </div>
    </div>
}