<div class="row mb-3">
    <div class="col-md-4">
        <dl>
            <dt>@Html.DisplayNameFor(model => model.Header.fit_diary)</dt>
            <dd>@Html.DisplayFor(model => model.Header.fit_diary)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.fit_start)</dt>
            <dd>@Html.DisplayFor(model => model.Header.fit_start)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.fit_fin)</dt>
            <dd>@Html.DisplayFor(model => model.Header.fit_fin)</dd>
        </dl>
    </div>
    <div class="col-md-4">
        <dl>
            <dt>@Html.DisplayNameFor(model => model.Header.fitter_work)</dt>
            <dd>@Html.DisplayFor(model => model.Header.fitter_work)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.fitters_instructions)</dt>
            <dd>@Html.DisplayFor(model => model.Header.fitters_instructions)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.fitter_comments)</dt>
            <dd>@Html.DisplayFor(model => model.Header.fitter_comments)</dd>
        </dl>
    </div>
    <div class="col-md-4">
        <dl>
            <dt>@Html.DisplayNameFor(model => model.Header.parts_used)</dt>
            <dd>@Html.DisplayFor(model => model.Header.parts_used)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.Id)</dt>
            <dd>@Html.DisplayFor(model => model.Header.Id)</dd>
        </dl>
    </div>
</div>

<hr />
<h4>Items</h4>
@if (Model.SurveyItems != null && Model.SurveyItems.Any())
{
    <table class="table table-sm table-bordered table-striped">
        <thead class="table-light">
            <tr>
                <th>Item</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SurveyItems)
            {
                <tr>
                    <td>@item.ItemName</td>
                    <td>
                        <a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No items found for this survey.</p>
}

@if (Model.Images != null && Model.Images.Any())
{
    <hr />
    <h4>Photos & Videos</h4>
    <div class="row">
        @foreach (var item in Model.Images)
        {
            <div class="col-md-4 mb-3">
                @if (item.Filename != null && item.Filename.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase))
                {
                    <video src="data:video/mp4;base64,@item.Data" class="img-fluid rounded" controls></video>
                    <a href="data:video/mp4;base64,@item.Data" download="@item.Filename" class="btn btn-sm btn-outline-primary mt-1"><i class="bi bi-download"></i> Download</a>
                }
                else
                {
                    <img src="data:image/png;base64,@item.Data" class="img-fluid rounded" />
                }
            </div>
        }
    </div>
}

<div>
    @if (ViewBag.ParentJobId != null)
    {
        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@ViewBag.ParentJobId">Back to Job Details</a>
    }
    else
    {
        <a asp-action="Index">Back to List</a>
    }
</div>
