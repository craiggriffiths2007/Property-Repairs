            <dt>@Html.DisplayNameFor(model => model.Header.uc_add2)</dt>
            <dd>@Html.DisplayFor(model => model.Header.uc_add2)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.uc_add3)</dt>
            <dd>@Html.DisplayFor(model => model.Header.uc_add3)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.uc_add4)</dt>
            <dd>@Html.DisplayFor(model => model.Header.uc_add4)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.uc_postcode)</dt>
            <dd>@Html.DisplayFor(model => model.Header.uc_postcode)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.uc_h_phone)</dt>
            <dd>@Html.DisplayFor(model => model.Header.uc_h_phone)</dd>
        </dl>
    </div>
    <div class="col-md-4">
        <dl>
            <dt>@Html.DisplayNameFor(model => model.Header.JobType)</dt>
            <dd>@Html.DisplayFor(model => model.Header.JobType)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.typeA)</dt>
            <dd>@Html.DisplayFor(model => model.Header.typeA)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.typeB)</dt>
            <dd>@Html.DisplayFor(model => model.Header.typeB)</dd>
            <dt>@Html.DisplayNameFor(model => model.Header.bComplete)</dt>
