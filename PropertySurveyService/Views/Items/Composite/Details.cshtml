@model PropertyRepairs.ViewModels.ItemDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h3>Composite</h3>
<hr />

<partial name="_ItemDetailsPartial" model="Model.Composite" />

@if (Model.Panel != null)
{
    <hr />
    <h4>Associated Panel</h4>
    <partial name="_ItemDetailsPartial" model="Model.Panel" />
}

@if (Model.Glass != null)
{
    <hr />
    <h4>Associated Glass</h4>
    <partial name="_ItemDetailsPartial" model="Model.Glass" />
}

<partial name="_ItemImagesPartial" model="Model.Images" />

