@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@model object

<div class="grid-container-vertical">
    @if (Model == null)
    {
        <div>No data</div>
    }
    else
    {
        var contractProp = Model.GetType().GetProperty(
            "ContractCode",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
        var contractCode = contractProp?.GetValue(Model) ?? "(n/a)";

        var itemProp = Model.GetType().GetProperty(
            "item_number",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase)
            ?? Model.GetType().GetProperty(
                "ItemNumber",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
        var itemNumber = itemProp?.GetValue(Model) ?? "(n/a)";

        <div>
            <strong style="color:dimgrey">Contract Code:</strong>
            <strong>
                @contractCode
            </strong>
        </div>
        <div>
            <strong style="color:dimgrey">Item Number:</strong>
            <strong>
                @itemNumber
            </strong>
        </div>
        <div>&nbsp;</div>



        var properties = Model.GetType()
            .GetProperties()
                .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
                .Select(p =>
                {
                    var display = p.GetCustomAttribute<DisplayAttribute>();
                    var label = display?.GetName() ?? p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name;
                    // DisplayAttribute exposes GetOrder(); if not set we treat it as max so those appear after ordered ones
                    var order = display?.GetOrder() ?? int.MaxValue;
                    return new
                    {
                        Property = p,
                        Label = label,
                        Order = order
                    };
                });
        //.OrderBy(x => x.Order)
                //.ThenBy(x => x.Label);

        foreach (var item in properties)
        {
            var value = item.Property.GetValue(Model);

            <div>
            @switch(item.Label)
            {
                    case "Plan Size A":
                        <img src="@(Url.Content("~/img/garageplan.png"))" class="img-fluid rounded" />
                        break;
                    case "Side Size A":
                        <img src="@(Url.Content("~/img/garageside.png"))" class="img-fluid rounded" />
                        break;
                }
            </div>
          


            <div>

                @item.Label:
                <strong>
                    @if (value is bool b)
                    {
                        var color = b ? "green" : "red";
                        <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                    }
                    else
                    {
                        @value
                    }
                </strong>
            </div>
        }
    }
</div>