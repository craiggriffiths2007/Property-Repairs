@model PropertySurveyService.ViewModels.ItemDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h3>
    @Model.Assembly.Material @(Model.Assembly.bRepair ? "Repair" : "Replace")
</h3>
<hr />

<partial name="_AssemblyDetailsPartial" model="Model.Assembly" />

@if (Model.Panel != null)
{
    <hr />
    <h4>Associated Panel</h4>
    <partial name="_ItemDetailsPartial" model="Model.Panel" />
}

@if (Model.Glass != null)
{
    <hr />
    <h4>Associated Glass</h4>
    <partial name="_ItemDetailsPartial" model="Model.Glass" />
}

<partial name="_ItemImagesPartial" model="Model.Images" />

