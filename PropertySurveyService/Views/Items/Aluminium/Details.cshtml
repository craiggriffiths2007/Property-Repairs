@model PropertySurveyService.ViewModels.ItemDetailsViewModel
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<h3>Aluminium</h3>
<hr />

<partial name="_ItemDetailsPartial" model="Model.Aluminium" />

@if (Model.Panel != null)
{
    <hr />
    <h4>Associated Panel</h4>
    <partial name="_ItemDetailsPartial" model="Model.Panel" />
}

@if (Model.Glass != null)
{
    <hr />
    <h4>Associated Glass</h4>
    <partial name="_ItemDetailsPartial" model="Model.Glass" />
}

@if (Model.Lockmech != null)
{
    <hr />
    <h4>Associated Locking</h4>
    <partial name="_ItemDetailsPartial" model="Model.Lockmech" />
}

<partial name="_ItemImagesPartial" model="Model.Images" />


