@model IEnumerable<PropertySurveyService.Models.MileageSheet>

@{
    ViewData["Title"] = "View1";
}

<h4>Mileage Sheets</h4>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.sheet_date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.registration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.start_postcode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.finish_postcode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.start_mileage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.end_mileage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.start_time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.end_time)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.sheet_date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.registration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.start_postcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.finish_postcode)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.start_mileage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.end_mileage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.start_time)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.end_time)
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
