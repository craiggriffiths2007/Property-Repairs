@model PropertySurveyService.Models.MileageSheet
@using System.ComponentModel
@using System.Reflection
@{
    ViewData["Title"] = "View";
}

<h4>Mileage Sheet</h4>
<hr />
<div class="grid-container-vertical">
    @if (Model == null)
    {
        <div>No data</div>
    }
    else
    {
        var properties = Model.GetType()
            .GetProperties()
            .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
            .Select(p => new
            {
                Property = p,
                Label = p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name
            })
            .OrderBy(x => x.Label);

        foreach (var item in properties)
        {
            var value = item.Property.GetValue(Model);

            <div>
                @item.Label:
                <strong>
                    @if (value is bool b)
                    {
                        var color = b ? "green" : "red";
                        <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                    }
                    else
                    {
                        @value
                    }
                </strong>
            </div>
        }
    }
</div>
<hr/>
 <h4>Photos</h4>
    <div class="container">
        <div class="row">
            <!-- Row 1 -->
            <div class="col-6 p-3 border">Start
                @{ var s = ViewData["StartImage"] as string; }
                @if(!string.IsNullOrEmpty(s)) { <img src="@Url.Content($"~/images/{s}")" class="img-fluid rounded" /> }
            </div>
            <div class="col-6 p-3 border">End
                @{ var e = ViewData["EndImage"] as string; }
                @if(!string.IsNullOrEmpty(e)) { <img src="@Url.Content($"~/images/{e}")" class="img-fluid rounded" /> }
            </div>
        </div>
        <div class="row">
            <!-- Row 2 -->
            <div class="col-6 p-3 border">Signature
                @{ var sig = ViewData["SignatureImage"] as string; }
                @if(!string.IsNullOrEmpty(sig)) { <img src="@Url.Content($"~/images/{sig}")" class="img-fluid rounded" /> }
            </div>
            
        </div>
    </div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
