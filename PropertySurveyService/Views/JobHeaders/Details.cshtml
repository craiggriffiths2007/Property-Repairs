@model PropertySurveyService.ViewModels.JobHeaderItemIndexViewModel
@using System.ComponentModel
@using System.Reflection
@using System.IO


@{
    ViewData["Title"] = "Details";
}

@if(Model.JobHeader.JobType == enum_job_type.Survey)
{
    <h3>Survey Header</h3>
}
@if (Model.JobHeader.JobType == enum_job_type.Fitting)
{
    <h3>Fitting Header</h3>
}
@if (Model.JobHeader.JobType == enum_job_type.Remedial)
{
    <h3>Remedial Header</h3>
}

<hr/>
@if (Model?.JobHeader == null)
{
    <div class="alert alert-warning">Header not found.</div>
}
else
{
    <div class="grid-container-vertical">
        @{
            var properties = Model.JobHeader.GetType()
                .GetProperties().Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false &&
                                            !string.IsNullOrWhiteSpace(p.GetValue(Model.JobHeader)?.ToString())
                )
                .Select(p => new
                {
                    Property = p,
                    Label = p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name
                });
            //.OrderBy(x => x.Label);
        }

        <div>
            <strong style="color:dimgrey">Contract Code:</strong>
            <strong>
                @Model.JobHeader.ContractCode
            </strong>
        </div>
        <div>
            <strong style="color:dimgrey">Diary Date:</strong>
            <strong>
                @Model.JobHeader.DiaryDate.ToShortDateString()
            </strong>
        </div>
        <div>&nbsp;</div>

        

        @foreach (var item in properties)
        {
            var value = item.Property.GetValue(Model.JobHeader);

            <div>
                @item.Label:
                <strong>

                    @if (value is bool b)
                    {
                        <span style="color: @(b ? "green" : "red"); font-weight: bold;">
                            @(b ? "✔" : "✘")
                        </span>

                    }
                    else
                    {
                        @value
                    }
                </strong>
            </div>
        }

        
        <div>
            <strong style="color:dimgrey">Report:</strong>

                <div id="instructions-editor">
                    @Html.Raw(Model.JobHeader.Report)
                </div>

        </div>

    </div>
}
<link href="~/lib/quill.snow.css" rel="stylesheet" />

<script src="~/lib/quill.js"></script>

<script>
    // Initialize Quill editor with color pickers
    const quill = new Quill('#instructions-editor', {
        theme: 'snow',
        readOnly: true,
        modules: {
            toolbar: '#toolbar-container'
        }
    });

    // Find the closest form containing the editor
    const form = document.querySelector('#instructions-editor').closest('form');
    const hiddenInput = document.getElementById('instructions-hidden');

    // Intercept the form submit to pass Quill's HTML into the ASP.NET hidden input
    form.addEventListener('submit', function() {
        // Get HTML content from Quill
        const htmlContent = quill.getSemanticHTML();

        // Put it in the hidden input so ASP.NET can bind it to Job.Instructions
        hiddenInput.value = htmlContent;
    });
</script>


@if(Model.JobHeader.garage_door_motor==true)
{
    <button type="button" onclick="openPrintWindow(1)">
        Garage Door Motor Decleration
    </button>
}
@if (Model.JobHeader.JobType > enum_job_type.Survey)
{
    <button type="button" onclick="openPrintWindow(2)">
        Signed Mandate
    </button>
}

<button type="button" 
    onclick="openInstructions('@Url.Action("JobInstructions", "JobHeaders", new { id = Model.JobHeader.Id })')">
    Job Instructions
</button>

<a href="javascript:history.go(-1);" >
    Back to Diary Job
</a>

@if (Model.SurveyItems != null && Model.SurveyItems.Any())
{
    <hr />
    <h4>Survey Items</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th style="width: 1%; white-space: nowrap;">No.</th>
                <th>Name</th>
                <th style="width: 1%;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SurveyItems)
            {
                <tr>
                    <td class="text-center">@item.item_number</td>
                    <td class="@(item.BaseItemType == enum_item_type.none ? "fw-bold" : "")">
                        @item.ItemTitle
                    </td>

                    <td class="text-end">
                        <a asp-controller="@item.ControllerName"
                           asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <p class="text-muted">No survey items found for this job.</p>
}



@if (Model.Images != null && Model.Images.Any())
{
    <hr />
    <h4>Images and Videos</h4>
    <div class="row">
        @foreach (var img in Model.Images)
        {
            var ext = System.IO.Path.GetExtension(img.Filename)?.ToLowerInvariant();
            if (ext == ".mp4" || ext == ".webm" || ext == ".ogg")
            {
                <div class="col-12 mb-3">
                    <video controls class="img-fluid" style="max-width:100%; height:auto;">
                        <source src="@Url.Content($"/images/{img.Filename}")" type="video/@(ext.TrimStart('.'))" />
                        Your browser does not support the video tag.
                    </video>
                    <div class="small text-muted">@img.Filename (@img.DateTime)</div>
                </div>
            }
            else
            {
               
                if (true)
                {
                    <div class="col-6 p-3 border">
                        <img src="/images/@img.Filename" class="img-fluid rounded" />
                    </div>
                }
            }
        }
    </div>
}
<script>
    function openInstructions(url) {
        // Opens a styled popup window with specific dimensions
        window.open(url, 'JobInstructionsPopup', 'width=800,height=600,scrollbars=yes,resizable=yes');
    }
</script>

<script>
    function openPrintWindow(type) {
        if(type==1)
        {
            window.open(
                '@Url.Action("GarageMotor", "JobHeaders", new { id = Model.JobHeader.Id })',
                '_blank',
                'width=900,height=700'
            );
        }
        if(type==2)
        {
            window.open(
                '@Url.Action("SignedMandate", "JobHeaders", new { id = Model.JobHeader.Id })',
                '_blank',
                'width=900,height=700'
            );
        }
        if(type==3)
        {
            window.open(
                '@Url.Action("JobInstructions", "JobHeaders", new { id = Model.JobHeader.Id })',
                '_blank',
                'width=900,height=700'
            );
        }
    }
</script>
