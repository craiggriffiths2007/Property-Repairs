@model PropertySurveyService.ViewModels.JobHeaderItemIndexViewModel
@using System.ComponentModel
@using System.Reflection


@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>




<div class="grid-container">
    @foreach (var prop in Model.JobHeader.GetType().GetProperties())
    {
        // Try to grab the DisplayNameAttribute from the property
        var displayNameAttr = prop.GetCustomAttribute<DisplayNameAttribute>();

        // Use the DisplayName if it exists, otherwise fall back to the property name
        var labelText = displayNameAttr != null ? displayNameAttr.DisplayName : prop.Name;

        <div>
            <strong>@labelText:</strong>
            @prop.GetValue(Model.JobHeader)
        </div>
    }
</div>



@if (Model.SurveyItems != null && Model.SurveyItems.Any())
{
    <hr />
    <h4>Item Records</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Item Number</th>
                <th>Name</th>
                <th>Date</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SurveyItems)
            {
                <tr>
                        <td>@item.item_number</td>
                    <td>@item.ItemName</td>
                  
                    <td>
                            <a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <p class="text-muted">No survey records found for this job.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.JobHeader.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
