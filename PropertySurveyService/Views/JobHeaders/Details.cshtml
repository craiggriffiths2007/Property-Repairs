@model PropertySurveyService.ViewModels.JobHeaderItemIndexViewModel
@using System.ComponentModel
@using System.Reflection
@using System.IO


@{
    ViewData["Title"] = "Details";
}

@if(Model.JobHeader.JobType == enum_job_type.Survey)
{
    <h3>Survey Job Header</h3>
}
@if (Model.JobHeader.JobType == enum_job_type.Fitting)
{
    <h3>Fitting Job Header</h3>
}
@if (Model.JobHeader.JobType == enum_job_type.Remedial)
{
    <h3>Remedial Job Header</h3>
}

<hr/>
@if (Model?.JobHeader == null)
{
    <div class="alert alert-warning">Job header not found.</div>
}
else
{
    <div class="grid-container-vertical">
        @{
            var properties = Model.JobHeader.GetType()
                        .GetProperties().Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
                        .Select(p => new
                        {
                            Property = p,
                            Label = p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name
                        });
            //.OrderBy(x => x.Label);
        }

        <div>
            <strong style="color:dimgrey">Contract Code:</strong>
            <strong>
                @Model.JobHeader.ContractCode
            </strong>
        </div>
        <div>
            <strong style="color:dimgrey">Diary Date:</strong>
            <strong>
                @Model.JobHeader.DiaryDate.ToShortDateString()
            </strong>
        </div>
        <div>&nbsp;</div>

        

        @foreach (var item in properties)
        {
            var value = item.Property.GetValue(Model.JobHeader);

            <div>
                @item.Label:
                <strong>
                    @if (value is bool b)
                    {
                        <span style="color: @(b ? "green" : "red"); font-weight: bold;">
                            @(b ? "✔" : "✘")
                        </span>
                    }
                    else
                    {
                        @value
                    }
                </strong>
            </div>
        }
    </div>
}

@if(Model.JobHeader.garage_door_motor==true)
{
    <button type="button" onclick="openPrintWindow()">
        Garage Door Motor Descleration
    </button>
}



@if (Model.SurveyItems != null && Model.SurveyItems.Any())
{
    <hr />
    <h4>Survey Items</h4>
    <table class="table table-sm table-bordered">
        <thead class="table-light">
            <tr>
                <th>Item Number</th>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.SurveyItems)
            {
                <tr>
                        <td>@item.item_number</td>
                    <td>@item.ItemName</td>
                  
                    <td>
                            <a asp-controller="@item.ControllerName" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-outline-primary btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <hr />
    <p class="text-muted">No survey items found for this job.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model?.JobHeader.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

@if (Model.Images != null && Model.Images.Any())
{
    <hr />
    <h4>Images and Videos</h4>
    <div class="row">
        @foreach (var img in Model.Images)
        {
            var ext = img.Filename.Substring(img.Filename.Length - 4)?.ToLowerInvariant();
            if (ext == ".mp4" || ext == ".webm" || ext == ".ogg")
            {
                <div class="col-12 mb-3">
                    <video controls class="img-fluid" style="max-width:100%; height:auto;">
                        <source src="data:video/@(ext.TrimStart('.'));base64,@img.Data" type="video/@(ext.TrimStart('.'))" />
                        Your browser does not support the video tag.
                    </video>
                    <div class="small text-muted">@img.Filename (@img.DateTime)</div>
                </div>
            }
            else
            {
                <div class="col-4 mb-3">
                    <img src="data:image/png;base64,@img.Data" class="img-fluid rounded" />
                  
                </div> 
            }
        }
    </div>
}


<script>
    function openPrintWindow() {
        window.open(
            '@Url.Action("GarageMotor", "Jobs")',
            '_blank',
            'width=900,height=700'
        );
    }
</script>
