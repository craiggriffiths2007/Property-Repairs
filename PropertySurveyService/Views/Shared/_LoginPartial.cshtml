@using Microsoft.AspNetCore.Identity
@using PropertySurveyService.Data

@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager

    @if (SignInManager.IsSignedIn(User))
    {
        @if (false)//(User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
        {
            <div class="nav-item">
                <a href="javascript:void(0)">Users ▼</a>
                <div class="dropdown">
                    <a asp-area="" asp-controller="Users" asp-action="Index">Users</a>
                    @if (false)// (User.IsInRole("SuperAdmin"))
                    {
                        
                        <a asp-area="" asp-controller="UserRoles" asp-action="Index">User Roles</a>
                 
                    }
                </div>

            </div>
        <img src="data:image/png;base64,@Convert.ToBase64String(UserManager.GetUserAsync(User).Result.ProfilePicture)" class="img-thumbnail" style="max-width:40px;max-height:40px;" />
            <a class="nav-item" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">User: @UserManager.GetUserAsync(User).Result.FirstName</a>
            <form class="nav-item" id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="btn btn-link">Logout</button>
            </form>
        }
    }
    else
    {
        <a class="nav-item" asp-area="Identity" asp-page="/Account/Register">Register</a>

        <a class="nav-item" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
    }


    

