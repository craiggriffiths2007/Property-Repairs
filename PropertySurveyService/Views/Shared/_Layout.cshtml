<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Property Repairs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PropertySurveyService.styles.css" asp-append-version="true" />

</head>

<body>
    <div class="navbar">
        <!-- LEFT -->
        <div class="nav-left">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index"><img src="/img/cs.png" width="60" height="60"></a>
            </div>
            @if (User.IsInRole("User") || User.IsInRole("Manager") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
            {
                <a class="nav-item" asp-controller="Jobs" asp-action="Index">Diary</a>

                <div class="nav-item">
                    <a class="text-white" href="javascript:void(0)">Contract ▼</a>
                    <div class="dropdown">
                        <a asp-controller="Contracts" asp-action="Index">Contracts</a>
                        <a asp-controller="Customers" asp-action="Index">Customers</a>
                       
                    </div>
                </div>

                <div class="nav-item">
                    <a class="text-white" href="javascript:void(0)">Branch ▼</a>
                    <div class="dropdown">
                        <a asp-controller="Branches" asp-action="Index">Branches</a>
                        <a asp-controller="ToolChecks" asp-action="Index">Tool Checks</a>
                        <a asp-controller="LadderChecks" asp-action="Index">Ladder Checks</a>
                        <a asp-controller="SpotChecks" asp-action="Index">Spot Checks</a>

                    </div>
                </div>

                <div class="nav-item">
                    <a class="text-white" href="javascript:void(0)">Vehicle ▼</a>
                    <div class="dropdown">
                        <a asp-controller="Vehicles" asp-action="Index">Vehicles</a>
                        <a asp-controller="VehicleChecks" asp-action="Index">Vehicle Checks</a>
                        <a asp-controller="VAccidents" asp-action="Index">Vehicle Accidents</a>
                    </div>
                </div>

                <div class="nav-item">
                    <a class="text-white" href="javascript:void(0)">Staff ▼</a>
                    <div class="dropdown">
                        <a asp-controller="Agents" asp-action="Index">Agents</a>
                        <a asp-controller="MileageSheets" asp-action="Index">Mileage Sheets</a>
                        <a asp-controller="FAccidents" asp-action="Index">Work Accidents</a>

                    </div>
                </div>
            }
        </div>
        <button onclick="window.print()" class="btn btn-primary no-print">
            <i class="fa fa-print"></i> Print &#128424;
        </button>
        <!-- RIGHT -->
        <div class="nav-right">
        
            <partial name="_LoginPartial" />

        </div>
    </div>
    <br/>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - None - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
    document.addEventListener("DOMContentLoaded", function () {
        // Using a event delegation makes this incredibly efficient and 
        // works even if tables are loaded dynamically via AJAX later.
        document.body.addEventListener("click", function (e) {
            // Find if the clicked element is inside a .clickable-row
            const row = e.target.closest(".clickable-row");
            
            // If it's a clickable row, and they DIDN'T click a link or button inside it
            if (row && e.target.tagName !== 'A' && e.target.tagName !== 'BUTTON') {
                const url = row.getAttribute("data-href");
                if (url) {
                    window.location.href = url;
                }
            }
        });
    });
</script>

</body>
</html>
