<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Property Repairs</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PropertySurveyService.styles.css" asp-append-version="true" />

</head>

<body>
    <div class="navbar">
        <!-- LEFT -->
        <div class="nav-left">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index"><img src="/img/cs.png" width="60" height="60"></a>
            </div>
            <div class="nav-item">
                <a asp-controller="Jobs" asp-action="Index">Jobs</a>
            </div>
            <div class="nav-item">
                <a asp-controller="Contracts" asp-action="Index">Contracts</a>
            </div>

            <div class="nav-item">
                <a href="javascript:void(0)">Branch ▼</a>
                <div class="dropdown">
                    <a asp-controller="Branches" asp-action="Index">Branches</a>
                    <a asp-controller="Vehicles" asp-action="Index">Vehicles</a>
                    <a asp-controller="VehicleChecks" asp-action="Index">Vehicle Checks</a>
                    <a asp-controller="ToolsTables" asp-action="Index">Tool Checks</a>
                    <a asp-controller="LaddersTables" asp-action="Index">Ladder Checks</a>
                </div>
            </div>

            <div class="nav-item">
                <a href="javascript:void(0)">People ▼</a>
                <div class="dropdown">
                    <a asp-controller="Customers" asp-action="Index">Customers</a>
                    <a asp-controller="Agents" asp-action="Index">Agents</a>
                    <a asp-controller="MileageSheet" asp-action="Index">Mileage</a>
                    <a asp-controller="Accident_Sheet" asp-action="Index">Accidents</a>
                </div>
            </div>
        </div>

        <!-- RIGHT -->
        <div class="nav-right">
        
            <partial name="_LoginPartial" />

        </div>
    </div>
    <br/>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Craigs Softwares - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
