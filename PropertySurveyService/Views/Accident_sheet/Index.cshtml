@model IEnumerable<PropertySurveyService.Models.VAccident>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.date_time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.t_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.t_reg)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.t_model)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.acc_date)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.acc_time)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.date_time)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.t_name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.t_reg)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.t_model)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.acc_date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.acc_time)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
