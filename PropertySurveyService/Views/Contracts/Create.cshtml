@model PropertyRepairs.Models.Contract

@{
    ViewData["Title"] = "Create";
}

<h4>Add Contract</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="CustomerId" class="control-label">Customer</label>
                <select asp-for="CustomerId" asp-items="@((SelectList)ViewBag.Customers)" class="form-control">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="IncidentDate" class="control-label"></label>
                <input asp-for="IncidentDate" class="form-control" />
                <span asp-validation-for="IncidentDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="InsuranceCompanyName" class="control-label"></label>
                <input asp-for="InsuranceCompanyName" class="form-control" />
                <span asp-validation-for="InsuranceCompanyName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DamageDescription" class="control-label"></label>
                <input asp-for="DamageDescription" class="form-control" />
                <span asp-validation-for="DamageDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CauseOfDamage" class="control-label"></label>
                <input asp-for="CauseOfDamage" class="form-control" />
                <span asp-validation-for="CauseOfDamage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
