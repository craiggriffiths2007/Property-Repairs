@model IEnumerable<PropertySurveyService.Models.FAccident>

@{
    ViewData["Title"] = "Index";
}

<h4>Work Accidents</h4>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.date_time)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.full_name)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.occupation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.filer_full_name)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.filer_occupation)
            </th>
            
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
            <tr class="clickable-row" data-href="@Url.Action("Details", new { id = item.Id })">
            <td>
                @Html.DisplayFor(modelItem => item.date_time)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.full_name)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.occupation)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.filer_full_name)
            </td>

            <td>
                @Html.DisplayFor(modelItem => item.filer_occupation)
            </td>
            
            <td>
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
