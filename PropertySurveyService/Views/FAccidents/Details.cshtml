@model PropertySurveyService.Models.FAccident
@using System.ComponentModel
@using System.Reflection

@{
    ViewData["Title"] = "Details";
}

<div>
    <h4>Work Accident</h4>
    <hr />



    <div class="grid-container-vertical">
        @if (Model == null)
        {
            <div>No data</div>
        }
        else
        {
            var properties = Model.GetType()
                .GetProperties()
                .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
                .Where(p =>
                {
                    if (p.PropertyType == typeof(string))
                    {
                        var val = (string?)p.GetValue(Model);
                        return !string.IsNullOrWhiteSpace(val);
                    }
                    return true;
                })
                .Select(p => new
                {
                    Property = p,
                    Label = p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name
                })
                .OrderBy(x => x.Label);

            foreach (var item in properties)
            {
                var value = item.Property.GetValue(Model);

                <div>
                    @item.Label:
                    <strong>
                        @if (value is bool b)
                        {
                            var color = b ? "green" : "red";
                            <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                        }
                        else
                        {
                            @value
                        }
                    </strong>
                </div>
            }
        }
    </div>
    <hr/>
</div>
<h4>Signatures</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.full_name)<img src="data:image/png;base64,@ViewData["sig_fname1"]" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.filer_full_name)<img src="data:image/png;base64,@ViewData["sig_fname2"]" class="img-fluid rounded" /></div>
    </div>
    @foreach (var image in ViewBag.Images)
    {
        <img src="data:image/png;base64,@image.Data" class="img-fluid rounded" />
    }
</div>