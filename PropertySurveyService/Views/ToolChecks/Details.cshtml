@model PropertySurveyService.Models.ToolCheck
@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@{
    ViewData["Title"] = "Details";
}

<div>
    <h4>Tool Check</h4>
    <hr />

    <div class="grid-container-vertical">
        @if (Model == null)
        {
            <div>No data</div>
        }
        else
        {
            var properties = Model.GetType()
                .GetProperties()
                .Where(p => p.GetCustomAttribute<BrowsableAttribute>()?.Browsable != false)
                .Select(p =>
                {
                    var display = p.GetCustomAttribute<DisplayAttribute>();
                    var label = display?.GetName() ?? p.GetCustomAttribute<DisplayNameAttribute>()?.DisplayName ?? p.Name;
                    // DisplayAttribute exposes GetOrder(); if not set we treat it as max so those appear after ordered ones
                    var order = display?.GetOrder() ?? int.MaxValue;
                    return new
                    {
                        Property = p,
                        Label = label,
                        Order = order
                    };
                })
                .OrderBy(x => x.Order)
                .ThenBy(x => x.Label);

            foreach (var item in properties)
            {
                var value = item.Property.GetValue(Model);
                var variable_name = item.Property.Name;
                var labelColor = "inherit";
                if (!string.IsNullOrEmpty(variable_name))
                {
                    if (variable_name.EndsWith("_a", System.StringComparison.OrdinalIgnoreCase))
                    {
                        labelColor = "darkblue";
                    }
                    else if (variable_name.EndsWith("_f", System.StringComparison.OrdinalIgnoreCase))
                    {
                        labelColor = "darkgreen";
                    }
                }
                <div>
                    <span style="color:@labelColor">@item.Label</span>:
                    <strong>
                        @if (value is bool b)
                        {
                            var color = b ? "green" : "red";
                            <span style="color:@color; font-weight: bold;">@(b ? "✔" : "✘")</span>
                        }
                        else
                        {
                            @value
                        }
                    </strong>
                </div>
            }
        }
    </div>
    <div style="border: 1px solid #ccc; background-color: #f9f9f9; padding: 15px; border-radius: 8px; display: inline-block;">
        <strong>Key : <br /><span style="color:darkblue">Available on request</span><br /><span style="color:darkgreen">Fit for purpose</span></strong>
    </div>
    <hr />
<h4>Signatures</h4>
<div class="container">
    <div class="row">
        <!-- Row 1 -->
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.signature_printed)<img src="data:image/png;base64,@ViewData["AuditSign"]" class="img-fluid rounded" /></div>
        <div class="col-6 p-3 border">@Html.DisplayFor(model => model.signature_printed2)<img src="data:image/png;base64,@ViewData["FitSign"]" class="img-fluid rounded" /></div>
    </div>
    @foreach (var image in ViewBag.Images)
    {
        <img src="data:image/png;base64,@image.Data" class="img-fluid rounded" />
    }
</div>

